# Nexus it - environment variables (names only; never commit real values).
# Copy to .env.local and fill in values for your own Supabase project.

# --- Supabase (required for auth, database and storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY is a legacy alias for the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY is a legacy alias for the secret key above.
SUPABASE_SERVICE_ROLE_KEY=

# --- Existing operational integrations (outside Sprint 1 "Foundation it") ---
TRACKPOD_API_KEY=

# --- Set automatically by Vercel; do not set locally ---
VERCEL_OIDC_TOKEN=
NEXUS_INTAKE_WEBHOOK_SECRET=
CRON_SECRET=
